{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyuncusempanze.github.io/Oyun-Rehberi/veri-kumeleri/schema-v1.json",
  "title": "Oyun-Rehberi record schema",
  "description": "SSS, rehber bölümü ve iddia birimi kayıtları için JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "language",
    "game",
    "game_slug",
    "record_type",
    "evidence_types",
    "sources",
    "content_url",
    "license",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "tr"
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "game_slug": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "faq",
        "guide_section",
        "claim"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_markdown": {
      "type": "string"
    },
    "article_title": {
      "type": "string",
      "minLength": 1
    },
    "section_title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_markdown": {
      "type": "string"
    },
    "evidence_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "official_source",
          "in_game_observation",
          "reference_source",
          "recommendation"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "content_url": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "enum": [
        "CC-BY-4.0"
      ]
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_markdown": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_type": {
      "enum": [
        "faq",
        "guide_section"
      ]
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "unit_index": {
      "type": "integer",
      "minimum": 1
    },
    "unit_type": {
      "enum": [
        "sentence",
        "paragraph",
        "list_item"
      ]
    },
    "source_unit_type": {
      "enum": [
        "paragraph",
        "list_item"
      ]
    },
    "evidence_scope": {
      "enum": [
        "unit",
        "parent_record"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "faq"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "question",
          "answer",
          "answer_markdown"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "guide_section"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "article_title",
          "section_title",
          "content",
          "content_markdown"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "claim"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "claim_text",
          "claim_markdown",
          "source_record_id",
          "source_record_type",
          "source_title",
          "section_title",
          "unit_index",
          "unit_type",
          "source_unit_type",
          "evidence_scope"
        ],
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      }
    }
  ]
}
