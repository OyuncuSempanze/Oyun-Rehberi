{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oyuncusempanze.github.io/Oyun-Rehberi/veri-kumeleri/schema-v1.json",
  "title": "Oyun-Rehberi record schema",
  "description": "SSS ve rehber bölümü kayıtları için JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "language",
    "game",
    "game_slug",
    "record_type",
    "evidence_types",
    "sources",
    "content_url",
    "license",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "tr"
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "game_slug": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "faq",
        "guide_section"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "answer_markdown": {
      "type": "string"
    },
    "article_title": {
      "type": "string",
      "minLength": 1
    },
    "section_title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "content_markdown": {
      "type": "string"
    },
    "evidence_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "official_source",
          "in_game_observation",
          "reference_source",
          "recommendation"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "content_url": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "const": "CC-BY-4.0"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "faq"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "question",
          "answer",
          "answer_markdown"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "guide_section"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "article_title",
          "section_title",
          "content",
          "content_markdown"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      }
    }
  ]
}
